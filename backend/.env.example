PORT=7000
JWT_SECRET=your_jwt_secret_key
MONGO_URI=mongodb://localhost:27017/eventdb
CLIENT_URL=your_client_url
SERVER_URL=your_server_url
NODE_ENV=your_node_env

# Google OAuth client (used for BOTH "Sign in with Google" login AND the
# Gmail API mailer below — same client works for both, just needs the
# gmail.send scope enabled/consented once via scripts/getGmailRefreshToken.js)
GOOGLE_CLIENT_ID=paste_your_client_id_here
GOOGLE_CLIENT_SECRET=paste_your_client_secret_here

# Gmail API mailer (replaces old EMAIL_USER / EMAIL_PASSWORD nodemailer setup)
# Generate GOOGLE_MAILER_REFRESH_TOKEN once by running:
#   node scripts/getGmailRefreshToken.js
GOOGLE_MAILER_REDIRECT_URI=http://localhost:7000/oauth2callback
GOOGLE_MAILER_REFRESH_TOKEN=paste_generated_refresh_token_here
GOOGLE_SENDER_EMAIL=the_gmail_address_you_send_from@gmail.com
